{
  "name": "@yuriy-ackermann/cyberpass-vq-importer",
  "version": "0.1.0",
  "description": "Browser TypeScript library for importing FIDO CyberPass Vendor Questionnaire Excel responses into the CyberPass questionnaire UI.",
  "keywords": ["cyberpass", "fido", "vendor-questionnaire", "excel", "xlsx", "typescript", "browser"],
  "license": "MIT",
  "author": "Yuriy Ackermann",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist", "README.md", "INTEGRATION.md", "LICENSE"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "xlsx": ">=0.18.0"
  },
  "engines": {
    "node": ">=18"
  }
}
