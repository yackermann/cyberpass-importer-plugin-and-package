{
  "name": "@yuriy-ackermann/cyberpass-vq-importer",
  "version": "0.2.0",
  "description": "Import standardized Vendor Questionnaire Excel files into typed requirement rows with response predictions, ID lookup, and optional file-input and drag-and-drop helpers.",
  "keywords": [
    "vq",
    "fido",
    "vendor-questionnaire",
    "excel",
    "xls",
    "typescript",
    "parser"
  ],
  "license": "MIT",
  "author": "Yuriy Ackermann",
  "type": "module",
  "sideEffects": [
    "./vendor/reader.mjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "INTEGRATION.md",
    "LICENSE",
    "vendor",
    "examples"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18"
  }
}
